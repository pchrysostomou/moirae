{
  "name": "moirae-protocols",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "moirae-core": "workspace:^"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "description": "Raft, single-decree Paxos and the ABD atomic register for the moirae simulator, transcribed from their papers, with their safety invariants.",
  "license": "Apache-2.0",
  "author": "Prodromos Chrysostomou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pchrysostomou/moirae.git",
    "directory": "packages/protocols"
  },
  "homepage": "https://github.com/pchrysostomou/moirae#readme",
  "keywords": [
    "deterministic-simulation",
    "distributed-systems",
    "testing",
    "simulation",
    "raft",
    "paxos",
    "abd"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
